<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SoftProof.ColorManagement</AssemblyName>
    <RootNamespace>SoftProof.ColorManagement</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftProof.Core\SoftProof.Core.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.5" />
  </ItemGroup>

  <!-- LittleCMS native library. Copied to the ROOT of every consuming app's output folder
       (next to SoftProof.UI.exe). Loose files under runtimes\<rid>\native are NOT probed by the
       .NET runtime unless they are declared in deps.json (NuGet-style), so the old
       runtimes\win-x64\native\ destination produced "unable to load DLL 'lcms2'". -->
  <ItemGroup>
    <None Update="runtimes\win-x64\native\lcms2.dll">
      <Link>lcms2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SoftProof.Tests" />
  </ItemGroup>

</Project>