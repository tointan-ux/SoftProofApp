<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>SoftProof.Tests</AssemblyName>
    <RootNamespace>SoftProof.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftProof.Core\SoftProof.Core.csproj" />
    <ProjectReference Include="..\SoftProof.ColorManagement\SoftProof.ColorManagement.csproj" />
    <ProjectReference Include="..\SoftProof.RIPParsers\SoftProof.RIPParsers.csproj" />
    <ProjectReference Include="..\SoftProof.Viewer\SoftProof.Viewer.csproj" />
    <ProjectReference Include="..\SoftProof.Tools\SoftProof.Tools.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.tif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.pbuf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference decoder: managed port of libtiff, used only to cross-check our strip decode. -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.649" />
  </ItemGroup>
</Project>