<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SoftProof</AssemblyName>
    <RootNamespace>SoftProof.UI</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SoftProof.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>SoftProof</Product>
    <AssemblyTitle>SoftProof — Prepress Soft Proofing</AssemblyTitle>
    <Company>tointan-ux</Company>
    <Description>Prepress soft-proofing, plate inspection and RIP verification</Description>
    <Copyright>Copyright © 2026 tointan-ux</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SoftProof.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftProof.Core\SoftProof.Core.csproj" />
    <ProjectReference Include="..\SoftProof.ColorManagement\SoftProof.ColorManagement.csproj" />
    <ProjectReference Include="..\SoftProof.RIPParsers\SoftProof.RIPParsers.csproj" />
    <ProjectReference Include="..\SoftProof.Viewer\SoftProof.Viewer.csproj" />
    <ProjectReference Include="..\SoftProof.Tools\SoftProof.Tools.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.22" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*.png" />
    <Resource Include="Resources\**\*.xaml" />
  </ItemGroup>
</Project>