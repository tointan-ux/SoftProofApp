<Window x:Class="SoftProof.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewer="clr-namespace:SoftProof.Viewer;assembly=SoftProof.Viewer"
        xmlns:vm="clr-namespace:SoftProof.UI.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1440" Height="860" MinWidth="1100" MinHeight="640"
        WindowState="Maximized"
        Background="{StaticResource SpAppBg}"
        TextElement.Foreground="{StaticResource SpTextPrimary}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown"
        DataContext="{Binding Main, Source={StaticResource Locator}}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadJobCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenPreferencesCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCompareCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseJobCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Menu + job header ================= -->
        <Border Grid.Row="0" Background="{StaticResource SpPanelBg}"
                BorderBrush="{StaticResource SpBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,0">
                <Menu DockPanel.Dock="Left" Style="{StaticResource MaterialDesignMenu}"
                      Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                        <MenuItem Header="Open _Folder..." Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="_Watch Folder..." Command="{Binding WatchFolderCommand}" />
                        <MenuItem Header="_Reload" Command="{Binding ReloadJobCommand}" InputGestureText="F5" />
                        <MenuItem Header="Close _Job" Command="{Binding CloseJobCommand}" InputGestureText="Ctrl+W" />
                        <Separator />
                        <MenuItem Header="Open _Demo Job" Command="{Binding OpenDemoJobCommand}" />
                        <MenuItem Header="_Recent Files" ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                    <EventSetter Event="Click" Handler="RecentFile_Click" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Pin / unpin" Click="RecentPin_Click"
                                                          ToolTip="Pinned entries stay at the top and are not trimmed" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Clear _Recent List" Command="{Binding ClearRecentCommand}" />
                        <Separator />
                        <MenuItem Header="Export _Report..." Command="{Binding ExportReportCommand}" />
                        <MenuItem Header="_Preferences..." Command="{Binding OpenPreferencesCommand}" InputGestureText="Ctrl+," />
                        <Separator />
                        <MenuItem Header="_Sign-Off" Command="{Binding SignOffCommand}"
                                  ToolTip="Requires a loaded job and a completed preflight with no failing checks."
                                  ToolTipService.ShowOnDisabled="True" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Fit to Window" Command="{Binding FitToWindowCommand}" InputGestureText="Ctrl+0" />
                        <MenuItem Header="_Actual Size (1:1)" Command="{Binding ZoomActualSizeCommand}" InputGestureText="1" />
                        <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                        <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                        <Separator />
                        <MenuItem Header="Side-by-side _Compare" Command="{Binding ToggleCompareCommand}" />
                        <Separator />
                        <MenuItem Header="Soft proof (ICC)" Click="ToggleSoftProof_Click"
                                  ToolTip="Renders the plates through the press profile instead of the screen approximation." />
                    </MenuItem>
                    <MenuItem Header="S_eparations">
                        <MenuItem Header="_All On" Command="{Binding ShowAllPlatesCommand}" />
                        <MenuItem Header="_CMYK Only" Command="{Binding ShowCmykOnlyCommand}" />
                        <MenuItem Header="_Spots Only" Command="{Binding ShowSpotsOnlyCommand}" />
                        <MenuItem Header="Clear _Solo" Command="{Binding ClearSoloCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Inspect">
                        <MenuItem Header="_Densitometer" InputGestureText="D"
                                  Command="{Binding SetToolCommand}"
                                  CommandParameter="{x:Static viewer:ViewerTool.Densitometer}" />
                        <MenuItem Header="_Caliper (Measure)" InputGestureText="M"
                                  Command="{Binding SetToolCommand}"
                                  CommandParameter="{x:Static viewer:ViewerTool.Measure}" />
                        <Separator />
                        <MenuItem Header="Run _Preflight" Command="{Binding RunPreflightCommand}" />
                        <MenuItem Header="IDG Analysis (loaded plate)" Command="{Binding RunIdgAnalysisCommand}" />
                        <MenuItem Header="Measure Density (loaded plate)" Command="{Binding MeasureDensityCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="Clear pyramid cache" Command="{Binding ClearPyramidCacheCommand}" />
                        <MenuItem Header="_About" Click="About_Click" />
                    </MenuItem>
                </Menu>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border CornerRadius="10" Padding="8,2" Margin="0,0,14,0"
                            Background="{StaticResource SpSuccessBg}"
                            Visibility="{Binding IsSignedOff, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SIGNED OFF" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="Profile: " Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                    <ComboBox x:Name="PressProfileBox" Width="190" Height="24" FontSize="11" Margin="0,0,4,0"
                              ItemsSource="{Binding PressProfiles}" SelectedItem="{Binding SelectedPressProfile, Mode=TwoWay}"
                              DisplayMemberPath="Name" IsEditable="True"
                              Text="{Binding PressProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              KeyDown="PressProfileBox_KeyDown"
                              ToolTip="Press profile. Pick one, or type a new name and press Enter to save the current thresholds under it." />
                    <TextBlock Text="Resolution: " Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="18,0,0,0" />
                    <TextBlock Text="{Binding ResolutionText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Toolbar ================= -->
        <Border Grid.Row="1" Background="{StaticResource SpPanelBg}" Padding="8,5"
                BorderBrush="{StaticResource SpBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource SpToolButton}" Command="ApplicationCommands.Open" ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" />
                            <TextBlock Text="Open" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Margin="6,0" Background="{StaticResource SpBorder}" />

                    <ToggleButton Style="{StaticResource SpToolToggle}" IsChecked="{Binding ShowPreflightPane}"
                                  ToolTip="Show / hide the preflight pane">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="16" Height="16" />
                            <TextBlock Text="Preflight" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Height="20" Margin="6,0" Background="{StaticResource SpBorder}" />

                    <RadioButton GroupName="Tools" Style="{StaticResource SpToolToggle}" ToolTip="Select (V)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Select}">
                        <materialDesign:PackIcon Kind="CursorDefault" Width="16" Height="16" />
                    </RadioButton>
                    <RadioButton GroupName="Tools" Style="{StaticResource SpToolToggle}" ToolTip="Pan (H, or hold Space / middle mouse)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Pan}">
                        <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" />
                    </RadioButton>

                    <Border Width="1" Height="20" Margin="6,0" Background="{StaticResource SpBorder}" />

                    <RadioButton GroupName="Tools" Style="{StaticResource SpToolToggle}" ToolTip="Densitometer (D)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Densitometer}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" />
                            <TextBlock Text="Densitometer" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Tools" Style="{StaticResource SpToolToggle}" ToolTip="Caliper / Measure (M)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Measure}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RulerSquare" Width="16" Height="16" />
                            <TextBlock Text="Measure" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <Border Width="1" Height="20" Margin="10,0" Background="{StaticResource SpBorder}" />

                    <Button Style="{StaticResource SpToolButton}" Command="{Binding FitToWindowCommand}" ToolTip="Fit to window (Ctrl+0)">
                        <materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource SpToolButton}" Command="{Binding ZoomActualSizeCommand}" ToolTip="Actual size (1)">
                        <TextBlock Text="1:1" FontFamily="Consolas" />
                    </Button>
                    <Button Style="{StaticResource SpToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out">
                        <materialDesign:PackIcon Kind="MagnifyMinus" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ZoomButton" Style="{StaticResource SpToolButton}" MinWidth="64"
                            Click="ZoomButton_Click" ToolTip="Zoom presets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ZoomText}" FontFamily="Consolas" FontWeight="SemiBold" />
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Margin="4,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="12%" Tag="0.125" Click="ZoomPreset_Click" />
                                <MenuItem Header="25%" Tag="0.25" Click="ZoomPreset_Click" />
                                <MenuItem Header="50%" Tag="0.5" Click="ZoomPreset_Click" />
                                <MenuItem Header="100%" Tag="1" Click="ZoomPreset_Click" />
                                <MenuItem Header="200%" Tag="2" Click="ZoomPreset_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource SpToolButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
                        <materialDesign:PackIcon Kind="MagnifyPlus" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SpToolToggle}"
                                  ToolTip="Side-by-side compare — two plates, synchronised zoom and pan"
                                  IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                                  Command="{Binding ToggleCompareCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Compare" Width="16" Height="16" />
                            <TextBlock Text="Side-by-side" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SpToolToggle}" IsChecked="{Binding ShowOriginalPixels}"
                                  ToolTip="Zoom to 100% of the plate and stream native pixels">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MagnifyPlus" Width="16" Height="16" />
                            <TextBlock Text="1:1 native" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SpToolToggle}" IsChecked="{Binding ShowContentOverlay}"
                                  ToolTip="Plate centre, content box, margin dimensions and offset (mm)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Crosshairs" Width="16" Height="16" />
                            <TextBlock Text="Centre" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Border Width="1" Height="20" Margin="6,0" Background="{StaticResource SpBorder}" />
                    <Button Style="{StaticResource SpToolButton}" Click="Refresh_Click" ToolTip="Re-composite plates">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Height="20" Margin="6,0" Background="{StaticResource SpBorder}" />
                    <Button Style="{StaticResource SpPrimaryButton}" Command="{Binding SignOffCommand}"
                            ToolTip="{Binding SignOffBlockReason}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckDecagram" Width="16" Height="16" />
                            <TextBlock Text="Sign-Off" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Workspace ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left: Inspection & Caliper -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" Background="{StaticResource SpPanelBg}"
                    BorderBrush="{StaticResource SpBorder}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Background="{StaticResource SpCardBg}"
                            BorderBrush="{StaticResource SpBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="◀" Style="{StaticResource SpChipButton}"
                                    Command="{Binding TogglePreflightPaneCommand}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" ToolTip="Collapse the preflight pane" />
                            <Button DockPanel.Dock="Right" Content="Run preflight" Style="{StaticResource SpChipButton}"
                                    Command="{Binding RunPreflightCommand}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="PREFLIGHT PLATE CHECK" FontSize="10" FontWeight="Bold"
                                           Style="{StaticResource SpMuted}" />
                                <TextBlock Text="{Binding PreflightSummary}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource SpAccentText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="RulerSquare" Width="18" Height="18"
                                                     Foreground="{StaticResource SpWarning}" VerticalAlignment="Center" />
                            <TextBlock Text="Inspection &amp; Caliper" Style="{StaticResource SpPanelTitle}" Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- Preflight results (failures and warnings first) -->
                        <ItemsControl ItemsSource="{Binding PreflightIssues}"
                                          MouseLeftButtonUp="PreflightList_MouseLeftButtonUp">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CircleOutline" />
                                                        <Setter Property="Foreground" Value="{StaticResource SpTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                <Setter Property="Kind" Value="CheckCircle" />
                                                                <Setter Property="Foreground" Value="{StaticResource SpSuccess}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Kind" Value="AlertCircle" />
                                                                <Setter Property="Foreground" Value="{StaticResource SpWarning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                <Setter Property="Kind" Value="CloseCircle" />
                                                                <Setter Property="Foreground" Value="{StaticResource SpDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SpMuted}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding PreflightPassedSummary}" Style="{StaticResource SpMuted}"
                                   FontSize="11" Margin="2,4,0,0"
                                   Visibility="{Binding HasPreflightPasses, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Centre: rulers + viewer + densitometer -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{StaticResource SpViewerBg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SpPanelBg}">
                        <TextBlock Text="mm" FontSize="9" Style="{StaticResource SpMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <viewer:MmRuler x:Name="RulerTop" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    Background="{StaticResource SpPanelBg}" Foreground="{StaticResource SpTextMuted}" />
                    <viewer:MmRuler x:Name="RulerLeft" Grid.Row="1" Grid.Column="0" Orientation="Vertical"
                                    Background="{StaticResource SpPanelBg}" Foreground="{StaticResource SpTextMuted}" />

                    <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Docked compare bar -->
                        <Border x:Name="CompareBar" Grid.Row="0" Visibility="Collapsed"
                                Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                BorderThickness="0,0,0,1" Padding="8,6">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="Exit compare (Esc)"
                                            Command="{Binding ExitCompareCommand}" Margin="10,0,0,0"
                                            Padding="8,2" FontSize="11" />

                                    <ToggleButton DockPanel.Dock="Right" Content="Sync pan/zoom"
                                                  IsChecked="{Binding CompareSyncLocked}" Margin="10,0,0,0"
                                                  Padding="8,2" FontSize="11"
                                                  ToolTip="Keep both panes at the same zoom and position" />

                                    <Button DockPanel.Dock="Right" Content="⇄ Swap"
                                            Command="{Binding SwapComparePlatesCommand}"
                                            IsEnabled="{Binding CanSwapCompare}"
                                            Margin="10,0,0,0" Padding="8,2" FontSize="11"
                                            ToolTip="Exchange the left and right plates" />

                                    <TextBlock Text="Mode" Style="{StaticResource SpMuted}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="{StaticResource SpBorder}" CornerRadius="6" Padding="2">
                                        <UniformGrid Columns="5">
                                            <RadioButton GroupName="ComparePresentation" Content="Side-by-side"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding ComparePresentation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SideBySide}" />
                                            <RadioButton GroupName="ComparePresentation" Content="Slide"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding ComparePresentation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Slide}" />
                                            <RadioButton GroupName="ComparePresentation" Content="Blink"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding ComparePresentation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Blink}" />
                                            <RadioButton GroupName="ComparePresentation" Content="Difference"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding ComparePresentation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Difference}" />
                                            <RadioButton GroupName="ComparePresentation" Content="RIP vs ref"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding ComparePresentation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=RipVsReference}" />
                                        </UniformGrid>
                                    </Border>
                                </DockPanel>

                                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                    <TextBlock Text="L" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox ItemsSource="{Binding Separations}" SelectedItem="{Binding CompareLeft}"
                                              DisplayMemberPath="Name" Width="150" Height="26" Margin="0,0,12,0" />

                                    <TextBlock Text="R" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox ItemsSource="{Binding Separations}" SelectedItem="{Binding CompareRight}"
                                              DisplayMemberPath="Name" Width="150" Height="26" Margin="0,0,8,0" />

                                    <Button Content="Compare with file…" Command="{Binding CompareWithFileCommand}"
                                            Padding="8,2" FontSize="11" Margin="0,0,6,0" />
                                    <Button Content="Reference…" Click="CompareReference_Click"
                                            Padding="8,2" FontSize="11" Margin="0,0,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                                Visibility="{Binding IsDifferenceMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Threshold" Style="{StaticResource SpMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Slider Minimum="0" Maximum="128" Value="{Binding DifferenceThreshold}"
                                                Width="120" VerticalAlignment="Center"
                                                ToolTip="Coverage delta that counts as a difference (0-128)" />
                                        <TextBlock Text="{Binding DifferenceThreshold}" Style="{StaticResource SpMono}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Text="· changed area" Style="{StaticResource SpMuted}"
                                                   VerticalAlignment="Center" Margin="10,0,4,0" />
                                        <TextBlock Text="{Binding DifferenceSummary}" Style="{StaticResource SpMono}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Canvas: two panes with a draggable splitter -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                                <ColumnDefinition x:Name="RightColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="LeftPane" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="LeftPaneHeader" Grid.Row="0" Visibility="Collapsed"
                                        Background="{StaticResource SpPanelBg}" BorderBrush="{StaticResource SpBorder}"
                                        BorderThickness="0,0,0,1" Padding="8,4">
                                    <TextBlock FontSize="11" Style="{StaticResource SpMuted}">
                                        <Run Text="LEFT   " />
                                        <Run Text="{Binding CompareLeft.Name, Mode=OneWay}" Foreground="{StaticResource SpTextPrimary}" />
                                    </TextBlock>
                                </Border>

                                <viewer:PlateViewer x:Name="Viewer" Grid.Row="1" />

                                <Canvas Grid.Row="1" IsHitTestVisible="False">
                                    <Border x:Name="HoverTip" Background="#E60B101A" BorderBrush="{StaticResource SpBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,4"
                                            Visibility="{Binding HasHoverReading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Coverage" FontSize="10" Style="{StaticResource SpMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HoverPercentText}" FontSize="11"
                                                       Style="{StaticResource SpMono}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Canvas>

                                <!-- Empty state -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRaster}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Open a RIP job to begin (Ctrl+O)" FontSize="16"
                                               Foreground="{StaticResource SpTextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop a TIFF or job folder here, or press Ctrl+O"
                                               Style="{StaticResource SpMuted}" HorizontalAlignment="Center" Margin="0,6,0,2" />
                                    <TextBlock Text="Recent files live under File ▸ Recent files."
                                               Style="{StaticResource SpMuted}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <Button Content="Open demo job" Style="{StaticResource SpChipButton}"
                                            HorizontalAlignment="Center" Command="{Binding OpenDemoJobCommand}" />
                                </StackPanel>

                                <!-- Cursor readout -->
                                <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                        Background="#CC0B101A" BorderBrush="{StaticResource SpBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,6" IsHitTestVisible="False"
                                        Visibility="{Binding HasRaster, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CursorXText}" Style="{StaticResource SpMono}" Margin="4,0,2,0" MinWidth="52" />
                                        <TextBlock Text="mm" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Y:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding CursorYText}" Style="{StaticResource SpMono}" Margin="4,0,2,0" MinWidth="52" />
                                        <TextBlock Text="mm" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Zoom:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding ZoomText}" Style="{StaticResource SpMono}" Margin="4,0,0,0"
                                                   Foreground="{StaticResource SpWarning}" FontWeight="SemiBold" />
                                        <TextBlock Text="View:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding ViewMode}" Style="{StaticResource SpMono}" Margin="4,0,0,0"
                                                   Foreground="{StaticResource SpSuccess}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <GridSplitter x:Name="CompareSplitter" Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{StaticResource SpBorder}" Visibility="Collapsed"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          ShowsPreview="True" />

                            <Grid x:Name="RightPane" Grid.Column="2" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="RightPaneHeader" Grid.Row="0"
                                        Background="{StaticResource SpPanelBg}" BorderBrush="{StaticResource SpBorder}"
                                        BorderThickness="0,0,0,1" Padding="8,4">
                                    <TextBlock FontSize="11" Style="{StaticResource SpMuted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="RIGHT   " />
                                        <Run Text="{Binding CompareRightTitle, Mode=OneWay}" Foreground="{StaticResource SpTextPrimary}" />
                                    </TextBlock>
                                </Border>

                                <viewer:PlateViewer x:Name="CompareViewer" Grid.Row="1" />

                                <!-- Same readout lane as the left pane -->
                                <!-- Cursor readout -->
                                <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                        Background="#CC0B101A" BorderBrush="{StaticResource SpBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,6" IsHitTestVisible="False"
                                        Visibility="{Binding HasRaster, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="X:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CursorXText}" Style="{StaticResource SpMono}" Margin="4,0,2,0" MinWidth="52" />
                                        <TextBlock Text="mm" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Y:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding CursorYText}" Style="{StaticResource SpMono}" Margin="4,0,2,0" MinWidth="52" />
                                        <TextBlock Text="mm" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Zoom:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding ZoomText}" Style="{StaticResource SpMono}" Margin="4,0,0,0"
                                                   Foreground="{StaticResource SpWarning}" FontWeight="SemiBold" />
                                        <TextBlock Text="View:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Text="{Binding ViewMode}" Style="{StaticResource SpMono}" Margin="4,0,0,0"
                                                   Foreground="{StaticResource SpSuccess}" />
                                    </StackPanel>
                                </Border>

                            </Grid>

                            <!-- Single-canvas comparison modes -->
                            <viewer:PlateCompareView x:Name="CompareOverlay" Grid.ColumnSpan="3"
                                                     Visibility="Collapsed" />
                        </Grid>

                    </Grid>
                </Grid>

            </Grid>

            <!-- Right: Separations & Plates -->
            <Border Grid.Column="2" Background="{StaticResource SpPanelBg}"
                    BorderBrush="{StaticResource SpBorder}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Layers" Width="18" Height="18"
                                                 Foreground="{StaticResource SpAccentText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PlatesTitle}" Style="{StaticResource SpPanelTitle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- View mode tabs -->
                    <Border Grid.Row="1" Background="{StaticResource SpCardBg}" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                        <UniformGrid Columns="4">
                            <RadioButton GroupName="ViewMode" Content="Composite" Style="{StaticResource SpSegmentTab}"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Composite}" />
                            <RadioButton GroupName="ViewMode" Content="Film B&amp;W" Style="{StaticResource SpSegmentTab}"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FilmBlackWhite}" />
                            <RadioButton GroupName="ViewMode" Content="Progressive" Style="{StaticResource SpSegmentTab}"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Progressive}" />
                        </UniformGrid>
                    </Border>

                    <!-- Progressive slider -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="Progressive">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SpMono}" Text="{Binding ProgressiveCount}" />
                            <TextBlock Text="Plates shown (press order)" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider Minimum="1" Maximum="{Binding ProgressiveMax}" Value="{Binding ProgressiveCount}"
                                TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <!-- Quick set -->
                    <DockPanel Grid.Row="3" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="Quick Set:" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="All On" Style="{StaticResource SpChipButton}" Command="{Binding ShowAllPlatesCommand}" />
                            <Button Content="CMYK" Style="{StaticResource SpChipButton}" Command="{Binding ShowCmykOnlyCommand}" Margin="6,0" />
                            <Button Content="Spots" Style="{StaticResource SpChipButton}" Command="{Binding ShowSpotsOnlyCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Plate list -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Separations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SeparationViewModel}">
                                    <Border Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,8">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Custom colour…" Click="SeparationCustomColor_Click" />
                                                    <MenuItem Header="Reset to RIP colour" Click="SeparationResetColor_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton Grid.Column="0" Style="{StaticResource SpEyeToggle}"
                                                              IsChecked="{Binding IsVisible}" ToolTip="Show / hide plate" />
                                                <Border Grid.Column="1" Width="42" Height="30" CornerRadius="3" Margin="4,0,8,0"
                                                        Background="White"
                                                        BorderBrush="{StaticResource SpTextMuted}" BorderThickness="1">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        <Border Background="#33F5B400" BorderBrush="{StaticResource SpWarning}" BorderThickness="1"
                                                                CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsSpotColor, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="SPOT" FontSize="9" FontWeight="Bold"
                                                                       Foreground="{StaticResource SpWarning}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding InfoLine}" Style="{StaticResource SpMuted}" TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="3" Content="S" Style="{StaticResource SpChipToggle}" Margin="0,0,4,0"
                                                              IsChecked="{Binding IsSolo}" IsEnabled="{Binding HasLayer}" ToolTip="Solo this plate" />
                                                <ToggleButton Grid.Column="4" Content="Inv" Style="{StaticResource SpChipToggle}"
                                                              IsChecked="{Binding IsInverted}" IsEnabled="{Binding HasLayer}" ToolTip="Invert (negative) view of this plate" />
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource SpMuted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Separation.FilePath}" />
                                                <ProgressBar Grid.Column="1" Style="{StaticResource SpThinBar}" Margin="10,0"
                                                             Value="{Binding InkedAreaPercent, Mode=OneWay}"
                                                             Foreground="{Binding DisplayBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding InkedAreaText}" Style="{StaticResource SpMono}"
                                                           FontWeight="SemiBold" MinWidth="44" TextAlignment="Right" />
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Opacity" Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity}"
                                                        Margin="10,0" IsEnabled="{Binding HasLayer}" ToolTip="Plate transparency" />
                                                <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                                           Style="{StaticResource SpMono}" VerticalAlignment="Center"
                                                           MinWidth="36" TextAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Simulation & orientation -->
                            <Expander IsExpanded="{Binding ShowSimulationSection, Mode=TwoWay}" Margin="0,0,6,10">
                                <Expander.Header>
                                    <TextBlock Text="SIMULATION &amp; ORIENTATION" FontSize="10" FontWeight="Bold"
                                               Style="{StaticResource SpMuted}" />
                                </Expander.Header>
                                <Border Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0"
                                        IsEnabled="{Binding HasRaster}">
                                <StackPanel>
                                    <TextBlock Text="Substrate" FontSize="11" Foreground="{StaticResource SpTextMuted}"
                                               Margin="0,10,0,4" />
                                    <Border Background="{StaticResource SpBorder}" CornerRadius="6" Padding="2">
                                        <UniformGrid Columns="3">
                                            <RadioButton GroupName="Substrate" Content="Opaque"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding OpaquePaper, Mode=TwoWay}"
                                                         ToolTip="Normal stock: inks multiply on white paper" />
                                            <RadioButton GroupName="Substrate" Content="Metallic"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding SimulateMetallicPaper, Mode=TwoWay}"
                                                         ToolTip="Metallic stock: dull silver paper with opaque white ink" />
                                            <RadioButton GroupName="Substrate" Content="Custom"
                                                         Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding UseCustomSubstrate, Mode=TwoWay}"
                                                         ToolTip="Use a picked paper colour" />
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="4" BorderBrush="{StaticResource SpTextMuted}"
                                                BorderThickness="1" Background="{Binding SubstrateBrush}" />
                                        <Button Content="Pick colour…" Click="SubstrateColor_Click" Margin="8,0,0,0"
                                                Padding="8,3" FontSize="11"
                                                IsEnabled="{Binding UseCustomSubstrate}" />
                                    </StackPanel>

                                    <TextBlock Text="Rotate" FontSize="11" Foreground="{StaticResource SpTextMuted}"
                                               Margin="0,10,0,4" />
                                    <Border Background="{StaticResource SpBorder}" CornerRadius="6" Padding="2">
                                        <UniformGrid Columns="4">
                                            <RadioButton GroupName="Rotation" Content="0°" Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding IsRotation0, Mode=OneWay}"
                                                         Command="{Binding RotateToCommand}" CommandParameter="0" />
                                            <RadioButton GroupName="Rotation" Content="90°" Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding IsRotation90, Mode=OneWay}"
                                                         Command="{Binding RotateToCommand}" CommandParameter="90" />
                                            <RadioButton GroupName="Rotation" Content="180°" Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding IsRotation180, Mode=OneWay}"
                                                         Command="{Binding RotateToCommand}" CommandParameter="180" />
                                            <RadioButton GroupName="Rotation" Content="270°" Style="{StaticResource SpSegmentTab}"
                                                         IsChecked="{Binding IsRotation270, Mode=OneWay}"
                                                         Command="{Binding RotateToCommand}" CommandParameter="270" />
                                        </UniformGrid>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <ToggleButton Content="Flip H" Margin="0,0,3,0" Padding="6,2" FontSize="11"
                                                      IsChecked="{Binding IsFlipHorizontal, Mode=OneWay}"
                                                      Command="{Binding FlipHorizontalCommand}"
                                                      ToolTip="Mirror the plate left to right" />
                                        <ToggleButton Content="Flip V" Margin="3,0,0,0" Padding="6,2" FontSize="11"
                                                      IsChecked="{Binding IsFlipVertical, Mode=OneWay}"
                                                      Command="{Binding FlipVerticalCommand}"
                                                      ToolTip="Mirror the plate top to bottom" />
                                    </UniformGrid>

                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="Reset orientation" Command="{Binding ResetOrientationCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalAlignment="Left" FontSize="11"
                                                Foreground="{StaticResource SpAccentText}"
                                                ToolTip="Clear rotation and both flips" />
                                        <TextBlock Text="{Binding ViewTransformText}" DockPanel.Dock="Right"
                                                   Style="{StaticResource SpMuted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="Back side opacity" FontSize="11" Foreground="{StaticResource SpTextMuted}"
                                               Margin="0,10,0,2" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding BackSideOpacity}"
                                            ToolTip="Mirror the back side over the front to check registration and bleed-through" />
                                    <TextBlock Text="{Binding BackSideOpacity, StringFormat=Back {0:P0}}"
                                               Style="{StaticResource SpMono}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- RIP queue -->
                            <Expander IsExpanded="{Binding ShowQueueSection, Mode=TwoWay}" Margin="0,0,6,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="RIP QUEUE" FontSize="10" FontWeight="Bold"
                                                   Style="{StaticResource SpMuted}" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource SpBorder}" CornerRadius="8"
                                                Padding="6,0" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding RipQueue.Count}" FontSize="10"
                                                       Style="{StaticResource SpMono}" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <Border Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0"
                                                    Style="{StaticResource SpChipButton}"
                                                    Command="{Binding RefreshQueueCommand}" />
                                            <TextBlock Text="{Binding QueueFolders}" Style="{StaticResource SpMuted}"
                                                       TextWrapping="Wrap" FontSize="10" />
                                        </DockPanel>

                                        <TextBlock Text="No watched folders yet. Add a folder and finished RIP output appears here."
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SpMuted}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RipQueue.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ListBox x:Name="QueueList" ItemsSource="{Binding RipQueue}" MaxHeight="220"
                                                 SelectionMode="Extended"
                                                 MouseDoubleClick="QueueList_MouseDoubleClick"
                                                 PreviewMouseRightButtonDown="QueueList_PreviewMouseRightButtonDown"
                                                 Background="Transparent" BorderThickness="0">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open selected files" Click="QueueOpenSelected_Click" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,2"
                                                                       ToolTip="{Binding Name}" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Left" Width="18" Height="16"
                                                                Background="{StaticResource SpBorder}" CornerRadius="3"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Chip}" FontSize="9" FontWeight="Bold"
                                                                       Style="{StaticResource SpMono}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border DockPanel.Dock="Right" Background="#2234D399" CornerRadius="3"
                                                                Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="LOADED" FontSize="8" FontWeight="Bold"
                                                                       Foreground="{StaticResource SpSuccess}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Button Content="Add watch folder…" Margin="0,6,0,0" Height="30"
                                                Command="{Binding AddWatchFolderCommand}"
                                                Background="Transparent" BorderBrush="{StaticResource SpAccent}"
                                                Foreground="{StaticResource SpAccentText}" FontSize="12" />
                                        <CheckBox Content="Auto-refresh when the RIP rewrites the file"
                                                  IsChecked="{Binding AutoRefresh}" FontSize="10" Margin="0,6,0,0" />
                                        <CheckBox Content="Auto-open new files from watched folders"
                                                  IsChecked="{Binding AutoOpenNewFiles}" FontSize="10" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- Navigator -->
                            <Expander IsExpanded="{Binding ShowNavigatorSection, Mode=TwoWay}" Margin="0,0,6,10">
                                <Expander.Header>
                                    <TextBlock Text="NAVIGATOR" FontSize="10" FontWeight="Bold"
                                               Style="{StaticResource SpMuted}" />
                                </Expander.Header>
                                <Border Background="{StaticResource SpCardBg}" BorderBrush="{StaticResource SpBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <Grid Height="180">
                                            <viewer:PlateNavigator x:Name="Navigator" Height="180"
                                                                   HorizontalAlignment="Stretch" />
                                            <Border Background="#E6151D30" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRaster}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="No job loaded" FontSize="12" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Open a job to see the plate overview" FontSize="10"
                                                               Style="{StaticResource SpMuted}" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DockPanel Margin="2,6,0,0" LastChildFill="False">
                                            <TextBlock Text="Viewport" FontSize="10" Style="{StaticResource SpMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NavigatorViewportText}" FontSize="10"
                                                       Style="{StaticResource SpMono}" DockPanel.Dock="Right"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Engine / screening -->
                    <Border Grid.Row="5" BorderBrush="{StaticResource SpBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Engine:" Style="{StaticResource SpMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding EngineText}" FontSize="11" FontWeight="SemiBold"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="Screening:" Style="{StaticResource SpMuted}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScreeningText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SpAccentText}" TextAlignment="Right" Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="3" Background="{StaticResource SpPanelBg}" Padding="12,4"
                BorderBrush="{StaticResource SpBorder}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding JobStatus}" Style="{StaticResource SpMuted}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ViewScaleText}" Style="{StaticResource SpMono}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelLoadCommand}"
                        IsEnabled="{Binding IsLoading}" Margin="10,0,0,0" Padding="8,1" FontSize="11" />
                <ProgressBar DockPanel.Dock="Right" Width="140" Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding LoadProgress}" Margin="10,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             ToolTip="{Binding StatusText}" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
