<Window x:Class="SoftProof.UI.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom ink colour" Width="392" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0f1626" Foreground="#e6ebf5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#b9c4dc" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Width" Value="12" />
        </Style>
        <Style x:Key="NsBox" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="CUSTOM SEPARATION COLOUR" FontSize="10" FontWeight="Bold" Foreground="#9aa7c2" />
        <TextBlock Text="Preview only. The RIP data is untouched."
                   FontSize="11" Foreground="#9aa7c2" TextWrapping="Wrap" Margin="0,4,0,10" />

        <StackPanel Orientation="Horizontal">
            <!-- Saturation / value square -->
            <Grid x:Name="SvSquare" Width="220" Height="220" ClipToBounds="True"
                  MouseLeftButtonDown="SvSquare_MouseLeftButtonDown"
                  MouseMove="SvSquare_MouseMove"
                  MouseLeftButtonUp="SvSquare_MouseLeftButtonUp">
                <Border x:Name="SvHueLayer" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2"
                             Fill="Transparent" />
                </Canvas>
            </Grid>

            <!-- Hue strip -->
            <Grid x:Name="HueStrip" Width="24" Height="220" Margin="12,0,0,0"
                  MouseLeftButtonDown="HueStrip_MouseLeftButtonDown"
                  MouseMove="HueStrip_MouseMove"
                  MouseLeftButtonUp="HueStrip_MouseLeftButtonUp">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueThumb" Width="24" Height="4" Fill="White" Stroke="#66000000" />
                </Canvas>
            </Grid>
        </StackPanel>

        <!-- Hex + preview -->
        <DockPanel Margin="0,14,0,0">
            <Border x:Name="Preview" Width="34" Height="34" CornerRadius="4"
                    BorderBrush="#33415c" BorderThickness="1" />
            <TextBlock Text="Hex" FontSize="11" Foreground="#b9c4dc" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox x:Name="HexBox" FontFamily="Consolas" VerticalContentAlignment="Center"
                     Height="26" TextChanged="HexBox_TextChanged" />
        </DockPanel>

        <!-- Numeric fields -->
        <UniformGrid Columns="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="R" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="RBox" Style="{StaticResource NsBox}" TextChanged="RgbBox_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="G" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="GBox" Style="{StaticResource NsBox}" TextChanged="RgbBox_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="B" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="BBox" Style="{StaticResource NsBox}" TextChanged="RgbBox_TextChanged" />
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="H" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="HBox" Style="{StaticResource NsBox}" TextChanged="HsvBox_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="S" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="SBox" Style="{StaticResource NsBox}" TextChanged="HsvBox_TextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="V" Style="{StaticResource NsLabel}" />
                <TextBox x:Name="VBox" Style="{StaticResource NsBox}" TextChanged="HsvBox_TextChanged" />
            </StackPanel>
        </UniformGrid>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button Content="⌖  Pick from screen" Click="Eyedropper_Click" Padding="10,5" HorizontalAlignment="Left" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="84" Padding="10,4" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Apply" IsDefault="True" MinWidth="84" Padding="10,4"
                    Click="Apply_Click" Background="#3b9be8" Foreground="White" BorderThickness="0" />
        </DockPanel>

        <TextBlock Text="Esc cancels · H 0–360 · S/V 0–100 · RGB 0–255"
                   FontSize="10" Foreground="#6b7894" Margin="0,10,0,0" />
    </StackPanel>
</Window>
