<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:SoftProof.UI.Converters">
    
    <!-- Converters -->
    
    <!-- Bool to Brush -->
    <local:BoolToBrushConverter x:Key="BoolToBrushConverter" 
                    TrueValue="{StaticResource AccentBrush}" 
                    FalseValue="{StaticResource PrimaryBrush}" />
    
    <!-- Bool to Visibility -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    
    <!-- Null to Visibility -->
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    
    <!-- Bool to Text -->
    <local:BoolToTextConverter x:Key="BoolToTextConverter" />
    
    <!-- Score to Brush -->
    <local:ScoreToBrushConverter x:Key="ScoreToBrushConverter" />
    
    <!-- Status to Brush -->
    <local:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    
    <!-- Job to Tree Converter -->
    <local:JobToTreeConverter x:Key="JobToTreeConverter" />
    
    <!-- Control Styles -->
    
    <!-- TextBox -->
    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- ComboBox -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Slider -->
    <Style TargetType="Slider" BasedOn="{StaticResource MaterialDesignSlider}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- CheckBox -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    
    <!-- Button -->
    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Height" Value="36" />
    </Style>
    
    <!-- Flat Button -->
    <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    
    <!-- Outline Button -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    
    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- DataGrid -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}" />
    </Style>
    
    <!-- ListView -->
    <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    
    <!-- TreeView -->
    <Style TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    
    <!-- TabControl -->
    <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}">
        <Setter Property="Margin" Value="0" />
    </Style>
    
    <!-- Separator -->
    <Style TargetType="Separator" BasedOn="{StaticResource MaterialDesignSeparator}">
        <Setter Property="Margin" Value="0,16,0,16" />
    </Style>
</ResourceDictionary>