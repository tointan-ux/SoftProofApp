<Project>
  <!-- Directory.Build.props - Shared MSBuild properties for all projects in SoftProofApp -->

  <PropertyGroup>
    <!-- Common build properties -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    <ArtifactsDir>$(SolutionDir)artifacts</ArtifactsDir>
    
    <!-- Version information -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview</VersionSuffix>
    <InformationalVersion>$(VersionPrefix)-$(VersionSuffix)</InformationalVersion>
    
    <!-- Package properties -->
    <Authors>tointan-ux</Authors>
    <Company>tointan-ux</Company>
    <Copyright>Copyright (c) 2024-2026 tointan-ux</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tointan-ux/SoftProofApp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tointan-ux/SoftProofApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>prepress;soft-proofing;color-management;icc;printing;wpf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Build configuration -->
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CS1573;CS1570;CS1998;NU1601;NU1901;NU1902;NU1903;SA1116;SA1117;SA1118;SA1413;SA1503;SA1519;SA1407;CA1062;CA1002;CA1003;CA1063;CA1305;CA1308;CA1512;CA1720;CA1805;CA1819;CA2227</WarningsNotAsErrors>
    
    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- NuGet -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    
    <!-- Target framework -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Common package references -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Copy README and icon to package output -->
  <ItemGroup Condition="Exists('$(SolutionDir)README.md')">
    <None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  

</Project>